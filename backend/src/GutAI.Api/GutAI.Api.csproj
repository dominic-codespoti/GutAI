<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\GutAI.Application\GutAI.Application.csproj" />
    <ProjectReference Include="..\GutAI.Infrastructure\GutAI.Infrastructure.csproj" />
    <InternalsVisibleTo Include="GutAI.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />
