{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.37.4.10188",
      "templateHash": "2031038177595535246"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources"
      }
    },
    "containerImage": {
      "type": "string",
      "metadata": {
        "description": "Full container image reference (e.g., ghcr.io/owner/repo:sha)"
      }
    },
    "jwtSecret": {
      "type": "securestring",
      "metadata": {
        "description": "JWT signing secret (min 32 chars)"
      }
    },
    "usdaApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "USDA FoodData Central API key"
      }
    },
    "ghcrUsername": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "GHCR username (GitHub username)"
      }
    },
    "ghcrPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "GHCR password (GitHub PAT with read:packages)"
      }
    },
    "azureOpenAIEndpoint": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Azure OpenAI (AI Foundry) endpoint URL"
      }
    },
    "azureContentUnderstandingEndpoint": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Azure Content Understanding endpoint URL"
      }
    },
    "azureOpenAIDeploymentName": {
      "type": "string",
      "defaultValue": "gpt-4o-mini",
      "metadata": {
        "description": "Azure OpenAI deployment name"
      }
    },
    "foundryProjectEndpoint": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Azure AI Foundry project endpoint URL"
      }
    },
    "alertEmailAddress": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Email address for optional Application Insights cost and scan-latency alerts. Leave empty to disable alerts."
      }
    },
    "scanCostP95ThresholdUsd": {
      "type": "string",
      "defaultValue": "0.05",
      "metadata": {
        "description": "P95 estimated AI cost per meal scan that triggers an alert, in USD (for example, 0.05)."
      }
    },
    "scanLatencyP95BudgetMs": {
      "type": "int",
      "defaultValue": 45000,
      "metadata": {
        "description": "P95 image-scan request duration budget that triggers an alert, in milliseconds (default is 75% of the 60-second scan deadline)."
      }
    }
  },
  "variables": {
    "prefix": "gutai-prod",
    "tags": {
      "project": "gutai"
    },
    "effectiveUsdaApiKey": "[if(empty(parameters('usdaApiKey')), 'unused', parameters('usdaApiKey'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[replace(format('{0}storage', variables('prefix')), '-', '')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/tableServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', replace(format('{0}storage', variables('prefix')), '-', ''), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', replace(format('{0}storage', variables('prefix')), '-', ''))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs', variables('prefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[format('{0}-appinsights', variables('prefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', variables('prefix')))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', variables('prefix')))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-env', variables('prefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', variables('prefix'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', variables('prefix'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', variables('prefix')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-api', variables('prefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', variables('prefix')))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "maxInactiveRevisions": 2,
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "http",
            "corsPolicy": {
              "allowedOrigins": [
                "*"
              ],
              "allowedMethods": [
                "*"
              ],
              "allowedHeaders": [
                "*"
              ]
            }
          },
          "registries": [
            {
              "server": "ghcr.io",
              "username": "[parameters('ghcrUsername')]",
              "passwordSecretRef": "ghcr-password"
            }
          ],
          "secrets": [
            {
              "name": "storage-connection",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix=core.windows.net', replace(format('{0}storage', variables('prefix')), '-', ''), listKeys(resourceId('Microsoft.Storage/storageAccounts', replace(format('{0}storage', variables('prefix')), '-', '')), '2023-05-01').keys[0].value)]"
            },
            {
              "name": "jwt-secret",
              "value": "[parameters('jwtSecret')]"
            },
            {
              "name": "usda-api-key",
              "value": "[variables('effectiveUsdaApiKey')]"
            },
            {
              "name": "ghcr-password",
              "value": "[parameters('ghcrPassword')]"
            },
            {
              "name": "appinsights-connection",
              "value": "[reference(resourceId('Microsoft.Insights/components', format('{0}-appinsights', variables('prefix'))), '2020-02-02').ConnectionString]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "api",
              "image": "[parameters('containerImage')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "ASPNETCORE_ENVIRONMENT",
                  "value": "Production"
                },
                {
                  "name": "ASPNETCORE_URLS",
                  "value": "http://+:8080"
                },
                {
                  "name": "ASPNETCORE_HTTP_PORTS",
                  "value": "8080"
                },
                {
                  "name": "DOTNET_RUNNING_IN_CONTAINER",
                  "value": "true"
                },
                {
                  "name": "DOTNET_GCServer",
                  "value": "0"
                },
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "secretRef": "appinsights-connection"
                },
                {
                  "name": "ConnectionStrings__AzureStorage",
                  "secretRef": "storage-connection"
                },
                {
                  "name": "Jwt__Secret",
                  "secretRef": "jwt-secret"
                },
                {
                  "name": "Jwt__Issuer",
                  "value": "GutAI"
                },
                {
                  "name": "Jwt__Audience",
                  "value": "GutAI"
                },
                {
                  "name": "Jwt__ExpiryMinutes",
                  "value": "60"
                },
                {
                  "name": "ExternalApis__UsdaApiKey",
                  "secretRef": "usda-api-key"
                },
                {
                  "name": "AzureOpenAI__Endpoint",
                  "value": "[parameters('azureOpenAIEndpoint')]"
                },
                {
                  "name": "AzureOpenAI__ContentUnderstandingEndpoint",
                  "value": "[parameters('azureContentUnderstandingEndpoint')]"
                },
                {
                  "name": "AzureOpenAI__DeploymentName",
                  "value": "[parameters('azureOpenAIDeploymentName')]"
                },
                {
                  "name": "Foundry__ProjectEndpoint",
                  "value": "[parameters('foundryProjectEndpoint')]"
                }
              ],
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 5,
                  "failureThreshold": 30,
                  "timeoutSeconds": 5
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "periodSeconds": 30,
                  "failureThreshold": 3,
                  "timeoutSeconds": 3
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "periodSeconds": 10,
                  "failureThreshold": 3,
                  "timeoutSeconds": 3
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 3,
            "rules": [
              {
                "name": "http-scaling",
                "http": {
                  "metadata": {
                    "concurrentRequests": "25"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', format('{0}-appinsights', variables('prefix')))]",
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', variables('prefix')))]",
        "[resourceId('Microsoft.Storage/storageAccounts', replace(format('{0}storage', variables('prefix')), '-', ''))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('alertEmailAddress')))]",
      "type": "Microsoft.Insights/actionGroups",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}-scan-alerts', variables('prefix'))]",
      "location": "global",
      "tags": "[variables('tags')]",
      "properties": {
        "groupShortName": "GutAIScan",
        "enabled": true,
        "emailReceivers": [
          {
            "name": "scan-alert-email",
            "emailAddress": "[parameters('alertEmailAddress')]",
            "useCommonAlertSchema": true
          }
        ]
      }
    },
    {
      "condition": "[not(empty(parameters('alertEmailAddress')))]",
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-scan-cost-p95', variables('prefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "LogAlert",
      "properties": {
        "displayName": "GutAI meal scan p95 AI cost exceeded",
        "description": "Alerts when p95 estimated AI cost per meal scan exceeds the configured USD threshold.",
        "severity": 2,
        "enabled": true,
        "evaluationFrequency": "PT15M",
        "windowSize": "PT1H",
        "scopes": [
          "[resourceId('Microsoft.Insights/components', format('{0}-appinsights', variables('prefix')))]"
        ],
        "targetResourceTypes": [
          "Microsoft.Insights/components"
        ],
        "autoMitigate": true,
        "criteria": {
          "allOf": [
            {
              "query": "            traces\n            | where tostring(customDimensions.Operation) == \"meal_scan\"\n            | extend EstimatedCostUsd = todouble(customDimensions.EstimatedCostUsd)\n            | where isnotnull(EstimatedCostUsd)\n            | summarize p95CostUsd = percentile(EstimatedCostUsd, 95)\n          ",
              "timeAggregation": "Average",
              "metricMeasureColumn": "p95CostUsd",
              "operator": "GreaterThan",
              "threshold": "[json(parameters('scanCostP95ThresholdUsd'))]",
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": [
            "[resourceId('Microsoft.Insights/actionGroups', format('{0}-scan-alerts', variables('prefix')))]"
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', format('{0}-appinsights', variables('prefix')))]",
        "[resourceId('Microsoft.Insights/actionGroups', format('{0}-scan-alerts', variables('prefix')))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('alertEmailAddress')))]",
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-scan-latency-p95', variables('prefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "LogAlert",
      "properties": {
        "displayName": "GutAI image scan p95 latency exceeded",
        "description": "Alerts when p95 POST /api/meals/scan/image request duration exceeds the configured millisecond budget.",
        "severity": 3,
        "enabled": true,
        "evaluationFrequency": "PT15M",
        "windowSize": "PT1H",
        "scopes": [
          "[resourceId('Microsoft.Insights/components', format('{0}-appinsights', variables('prefix')))]"
        ],
        "targetResourceTypes": [
          "Microsoft.Insights/components"
        ],
        "autoMitigate": true,
        "criteria": {
          "allOf": [
            {
              "query": "            requests\n            | where tostring(name) == \"POST /api/meals/scan/image\"\n            | summarize p95DurationMs = percentile(duration / 1ms, 95)\n          ",
              "timeAggregation": "Average",
              "metricMeasureColumn": "p95DurationMs",
              "operator": "GreaterThan",
              "threshold": "[parameters('scanLatencyP95BudgetMs')]",
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": [
            "[resourceId('Microsoft.Insights/actionGroups', format('{0}-scan-alerts', variables('prefix')))]"
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', format('{0}-appinsights', variables('prefix')))]",
        "[resourceId('Microsoft.Insights/actionGroups', format('{0}-scan-alerts', variables('prefix')))]"
      ]
    }
  ],
  "outputs": {
    "apiUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('{0}-api', variables('prefix'))), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[replace(format('{0}storage', variables('prefix')), '-', '')]"
    },
    "resourceGroupName": {
      "type": "string",
      "value": "[resourceGroup().name]"
    }
  }
}