{
  "name": "frontend",
  "version": "1.0.10",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform all",
    "build:prod": "eas build --profile production --platform all",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:all": "eas submit --platform all --profile production",
    "postinstall": "node scripts/patch-navigation-container.js",
    "test:auth-reconnect": "npx tsx --test src/stores/__tests__/auth-reconnect.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "^14.0.2",
    "@react-navigation/native": "^7.1.28",
    "@shopify/react-native-skia": "^2.11.1",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.5",
    "expo": "~55.0.30",
    "expo-camera": "~55.0.23",
    "expo-constants": "~55.0.7",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.5",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.19",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.2",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.4",
    "expo-store-review": "~55.0.18",
    "punycode": "^2.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-purchases": "^9.10.5",
    "react-native-purchases-ui": "^9.10.5",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "victory-native": "^42.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "expo-build-properties": "~55.0.18",
    "react-native-svg-transformer": "^1.5.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@shopify/react-native-skia"
      ]
    }
  }
}
